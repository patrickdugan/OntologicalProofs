import Neoplatonic.LTR.Nullary
import Neoplatonic.LTR.HaltingGeometry

/-!
# A first-order syntactic realization of the accelerated stream map

The partial-recursive program e induces a concrete language endomorphism,
renaming its nullary predicate P_n to P_(2n) exactly when the bounded
evaluator says that e has halted by stage n.

For every Boolean stream, the truth value of each transformed atomic
sentence is exactly that of the stream-map from HaltingGeometry.lean.
The endomorphism acts on all first-order formulas through mathlib's
Language.LHom.onSentence. Extending the coordinate equality to a
homeomorphism statement for the entire completion space is a separate
formalization obligation.
-/

namespace Neoplatonic.LTR.Nullary

open FirstOrder
open FirstOrder.Language

/-- The effective source-coordinate index used by the halting construction. -/
def haltingIndex (e : Nat.Partrec.Code) (n : ℕ) : ℕ :=
  if stagedHalting e n = true then 2 * n else n

/-- A genuine first-order language homomorphism, generated by an actual
partial-recursive program and its fuel-bounded evaluation. -/
def haltingRename (e : Nat.Partrec.Code) : L →ᴸ L :=
  rename (haltingIndex e)

/-- The Boolean stream action is exactly the coordinate substitution. -/
theorem haltingIndex_stream (e : Nat.Partrec.Code)
    (bits : ℕ → Bool) (n : ℕ) :
    bits (haltingIndex e n) =
      acceleratedStream (stagedHalting e) bits n := by
  cases h : stagedHalting e n with
  | false => simp [haltingIndex, acceleratedStream, h]
  | true => simp [haltingIndex, acceleratedStream, h]

/-- Atomic first-order truth values realize the computable accelerated
Cantor-space transformation, using an explicit one-element model. -/
theorem haltingRename_realizes_atom (e : Nat.Partrec.Code)
    (bits : ℕ → Bool) (n : ℕ) :
    (letI : L.Structure Unit := unitStructure bits
     Unit ⊨ (haltingRename e).onSentence (atom n)) ↔
       acceleratedStream (stagedHalting e) bits n = true := by
  letI : L.Structure Unit := unitStructure bits
  rw [haltingRename, rename_atom, unit_realizes_atom]
  rw [haltingIndex_stream e bits n]

end Neoplatonic.LTR.Nullary
