import Neoplatonic.LTR.NullaryFullSentenceTranslation

/-!
# Concrete index and metric moduli for nullary first-order endomorphisms

A surjective enumeration of all expanded-language sentences supplies
an index for every renamed sentence of the genuine nullary language
endomorphism induced by a partial-recursive code.

The resulting lookup satisfies the semantic pullback law on every
completed theory, including quantified sentences. Instantiating the
general numbered-semantic-map theorem gives explicit finite-prefix
and epsilon-delta moduli for the actual nullary syntax map on
the sentence-numbered Stone metric.

The lookup chooses an index classically from the supplied surjection.
Computable syntax alone does not give a truth decision oracle.
-/

namespace Neoplatonic.LTR.Nullary

open FirstOrder
open FirstOrder.Language

/-- Any surjective enumeration of original nullary sentences gives a
surjective enumeration of the entire empty-constant expansion. -/
def liftedSentenceCode (originalCode : ℕ → L.Sentence) :
    ℕ → L[[Empty]].Sentence :=
  fun n => liftedSentence (originalCode n)

/-- Every expanded sentence is covered, because adding no constants
is a language equivalence. -/
theorem liftedSentenceCode_surjective
    (originalCode : ℕ → L.Sentence)
    (hcode : Function.Surjective originalCode) :
    Function.Surjective (liftedSentenceCode originalCode) := by
  intro ψ
  obtain ⟨n, hn⟩ := hcode (unliftExpandedSentence ψ)
  refine ⟨n, ?_⟩
  change liftedSentence (originalCode n) = ψ
  rw [hn]
  exact lift_unliftExpandedSentence ψ

/-- For each expanded target sentence, choose a source code for its
genuine halting-index-renamed sentence. -/
noncomputable def haltingSentenceLookup
    (code : ℕ → L[[Empty]].Sentence)
    (hcode : Function.Surjective code)
    (e : Nat.Partrec.Code) (j : ℕ) : ℕ :=
  Classical.choose (hcode (expandedHaltingRename e (code j)))

theorem haltingSentenceLookup_spec
    (code : ℕ → L[[Empty]].Sentence)
    (hcode : Function.Surjective code)
    (e : Nat.Partrec.Code) (j : ℕ) :
    code (haltingSentenceLookup code hcode e j) =
      expandedHaltingRename e (code j) :=
  Classical.choose_spec (hcode (expandedHaltingRename e (code j)))

/-- The translated index has exactly the semantic meaning required
by the general semantic-map theorem on all expanded sentences. -/
theorem haltingSentenceLookup_truth
    (code : ℕ → L[[Empty]].Sentence)
    (hcode : Function.Surjective code)
    (e : Nat.Partrec.Code) :
    ∀ j (p : T.CompleteType Empty),
      code j ∈ syntaxMap e p ↔
        code (haltingSentenceLookup code hcode e j) ∈ p := by
  intro j p
  rw [haltingSentenceLookup_spec code hcode e j]
  exact syntaxMap_expanded_semantics e p (code j)

/-- Concrete finite-prefix control for the actual nullary-language
syntactic endomorphism, instantiated on full sentence enumerations. -/
theorem syntaxMap_numbered_prefixTransfer
    (code : ℕ → L[[Empty]].Sentence)
    (hcode : Function.Surjective code)
    (e : Nat.Partrec.Code)
    (n : ℕ) (p q : T.CompleteType Empty)
    (hsource : ∀ i,
      i < sentenceIndexPrefixModulus
        (haltingSentenceLookup code hcode e) n →
      (code i ∈ p ↔ code i ∈ q)) :
    ∀ j, j < n → (code j ∈ syntaxMap e p ↔ code j ∈ syntaxMap e q) :=
  numberedSemanticMap_prefixTransfer
    code code (syntaxMap e)
    (haltingSentenceLookup code hcode e)
    (haltingSentenceLookup_truth code hcode e)
    n p q hsource

/-- Metric-ball continuity for the genuine completed-theory map
generated by a partial recursive program's syntactic rename. -/
theorem syntaxMap_numbered_radiusTransfer
    (code : ℕ → L[[Empty]].Sentence)
    (hcode : Function.Surjective code)
    (e : Nat.Partrec.Code)
    (n : ℕ) (p q : T.CompleteType Empty)
    (hnear :
      (letI : MetricSpace (T.CompleteType Empty) :=
        numberedSentenceMetric code hcode; dist q p) ≤
        (1 / 2 : ℝ)^sentenceIndexPrefixModulus
          (haltingSentenceLookup code hcode e) n) :
    (letI : MetricSpace (T.CompleteType Empty) :=
      numberedSentenceMetric code hcode;
      dist (syntaxMap e q) (syntaxMap e p)) ≤
        (1 / 2 : ℝ)^n := by
  exact numberedSemanticMap_radiusTransfer
    code code hcode hcode (syntaxMap e)
    (haltingSentenceLookup code hcode e)
    (haltingSentenceLookup_truth code hcode e) n p q hnear

/-- Explicit epsilon-delta uniform continuity of the real
first-order endomorphism in the sentence-numbered ultrametric. -/
theorem syntaxMap_numbered_uniformModulus
    (code : ℕ → L[[Empty]].Sentence)
    (hcode : Function.Surjective code)
    (e : Nat.Partrec.Code)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ p q : T.CompleteType Empty,
      (letI : MetricSpace (T.CompleteType Empty) :=
        numberedSentenceMetric code hcode; dist q p) < δ →
      (letI : MetricSpace (T.CompleteType Empty) :=
        numberedSentenceMetric code hcode;
        dist (syntaxMap e q) (syntaxMap e p)) < ε := by
  exact numberedSemanticMap_uniformModulus
    code code hcode hcode (syntaxMap e)
    (haltingSentenceLookup code hcode e)
    (haltingSentenceLookup_truth code hcode e) ε hε

end Neoplatonic.LTR.Nullary
