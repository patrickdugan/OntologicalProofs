import Neoplatonic.LTR.Acceleration
import Mathlib.Computability.Halting

/-!
# Halting-hardness of finite geometric distortion

Mathlib already proves the halting problem for actual Nat.Partrec.Code is
undecidable. Its evaln is a primitive-recursive fuel-bounded evaluator,
with monotonicity and soundness/completeness against the partial evaluator.

Use the fuel-bounded halting signal to construct a family of total stream
maps. If the program never halts the map is the identity and has delay 0.
If it halts the map eventually reads x(2n), giving unbounded delay.

The resulting noncomputability theorem is unconditional relative to
mathlib's existing halting theorem. It makes no assumptions about a new
incompleteness theorem and does not assert any result about a canonical
Dirac spectrum.
-/

namespace Neoplatonic.LTR

/-- Primitive-recursive bounded evaluation, expressed as a Boolean signal.
The already-established mathlib theorem Code.primrec_evaln supports the
effectivity claim for the stage evaluator. -/
def stagedHalting (e : Nat.Partrec.Code) (n : ℕ) : Bool :=
  (Nat.Partrec.Code.evaln n e 0).isSome

/-- Once a partial recursive program halts in the bounded evaluator, it
continues to do so at every later stage. -/
theorem stagedHalting_mono (e : Nat.Partrec.Code) :
    ∀ a b, a ≤ b → stagedHalting e a = true →
      stagedHalting e b = true := by
  intro a b hab ha
  cases hstage : Nat.Partrec.Code.evaln a e 0 with
  | none =>
      simp [stagedHalting, hstage] at ha
  | some x =>
      have hx : x ∈ Nat.Partrec.Code.evaln a e 0 := by
        simp [hstage]
      have hy : x ∈ Nat.Partrec.Code.evaln b e 0 :=
        Nat.Partrec.Code.evaln_mono hab hx
      cases hnext : Nat.Partrec.Code.evaln b e 0 with
      | none =>
          simp [hnext] at hy
      | some y =>
          simp [stagedHalting, hnext]

/-- Eventual activation is equivalent to the actual domain of a partial
recursive evaluation at input 0. -/
theorem stagedHalting_exists_iff_dom (e : Nat.Partrec.Code) :
    (∃ n, stagedHalting e n = true) ↔ (e.eval 0).Dom := by
  constructor
  · rintro ⟨n, hn⟩
    cases hstage : Nat.Partrec.Code.evaln n e 0 with
    | none =>
        simp [stagedHalting, hstage] at hn
    | some x =>
        have hx : x ∈ Nat.Partrec.Code.evaln n e 0 := by
          simp [hstage]
        have heval : x ∈ e.eval 0 := Nat.Partrec.Code.evaln_sound hx
        exact Part.dom_iff_mem.mpr ⟨x, heval⟩
  · intro hdom
    obtain ⟨x, hx⟩ := Part.dom_iff_mem.mp hdom
    obtain ⟨n, hn⟩ := Nat.Partrec.Code.evaln_complete.mp hx
    refine ⟨n, ?_⟩
    cases hstage : Nat.Partrec.Code.evaln n e 0 with
    | none =>
        simp [hstage] at hn
    | some x =>
        simp [stagedHalting, hstage]

/-- Finite delay is precisely nonhalting, with no external bridge axiom. -/
theorem stagedHalting_finite_delay_iff (e : Nat.Partrec.Code) :
    (∃ c, TranslationDelay (fun x : ℕ → Bool => x)
      (fun x : ℕ → Bool => x) (acceleratedStream (stagedHalting e)) c) ↔
      ¬ (e.eval 0).Dom := by
  rw [acceleratedStream_finite_delay_iff (stagedHalting e)
    (stagedHalting_mono e)]
  constructor
  · intro h hn
    obtain ⟨n, hstage⟩ := (stagedHalting_exists_iff_dom e).mpr hn
    have hfalse := h n
    rw [hstage] at hfalse
    cases hfalse
  · intro h n
    cases hv : stagedHalting e n with
    | false => rfl
    | true =>
        have hh : (e.eval 0).Dom :=
          (stagedHalting_exists_iff_dom e).mp ⟨n, hv⟩
        exact False.elim (h hh)

/-- Fully kernel-checked Godelian obstruction: there is no algorithm deciding
whether the marked stream transformation generated by a partial recursive
program has some finite additive logical delay. By the verified
delay-metric equivalence, this is also the dyadic geometric distortion
problem with an existential integer-power Lipschitz bound. -/
theorem finite_geometric_distortion_undecidable :
    ¬ ComputablePred (fun e : Nat.Partrec.Code =>
      ∃ c, TranslationDelay (fun x : ℕ → Bool => x)
        (fun x : ℕ → Bool => x)
        (acceleratedStream (stagedHalting e)) c) := by
  intro hdec
  have hnonhalt : ComputablePred (fun e : Nat.Partrec.Code =>
      ¬ (e.eval 0).Dom) :=
    ComputablePred.of_eq hdec (fun e => stagedHalting_finite_delay_iff e)
  have hhalting : ComputablePred (fun e : Nat.Partrec.Code =>
      (e.eval 0).Dom) := by
    apply ComputablePred.of_eq (ComputablePred.not hnonhalt)
    intro e
    simp
  exact (ComputablePred.halting_problem 0) hhalting

end Neoplatonic.LTR
